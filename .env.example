# Copy to .env (git-ignored) and fill in. Never commit real values.
# ── Anthropic ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# ── Google / Sheets ────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_service_account.json
SHEET_ID_MISSOES=<google-sheet-id>
SHEET_ID_FREE_SPINS=<google-sheet-id>

# ── BigQuery (CRM platform data warehouse export) ─────────────
CRM_BQ_KEY_PATH=credentials/bq_service_account.json
CRM_BQ_PROJECT_ID=<gcp-project-id>
CRM_BQ_DATASET=<dataset>

# ── Offer rules ────────────────────────────────────────────────
VIP_MIN_SPIN_VALUE=<min spin value for VIP offers>
